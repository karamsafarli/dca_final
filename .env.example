# Copy to `.env` to override the demo defaults used by docker-compose.yml.
# The defaults let the jury run `docker compose up --build` with zero setup;
# set real values for any non-demo deployment.
POSTGRES_USER=crisis_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=urban_crisis
JWT_SECRET=generate-with-openssl-rand-hex-32
ROUTING_API_CONTROL_TOKEN=change-me-too
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
