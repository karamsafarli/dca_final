{
  "name": "urban-crisis-backend",
  "version": "1.0.0",
  "description": "Urban Crisis & Crowd Evacuation Engine Backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "vitest": "^3.0.9"
  }
}
